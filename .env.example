# Copy to .env and fill in real values. Never commit .env.

# --- Business Central MCP (Sales, read-only) — LIVE ---
BC_MCP_SALES_RO_URL=
BC_MCP_SALES_RO_TOKEN=

# --- Shopify Storefront MCP — PLANNED ---
# MUST point at the staging/sandbox store, never the live production store.
# Endpoint shape is https://{store}.myshopify.com/.well-known/mcp/storefront
# on Shopify Plus stores; no token needed for read-only storefront access.
# {store} here is the staging store's myshopify domain — confirm it in
# docs/connectors/shopify.md before filling this in.
SHOPIFY_STAGING_STOREFRONT_MCP_URL=

# --- Zendesk MCP — PLANNED ---
# See docs/connectors/zendesk.md for which implementation we've settled on.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# --- Qarma — RESEARCH ---
# No public MCP server exists yet. Add vars here once we decide whether to
# build a thin custom server against Qarma's API (see docs/connectors/qarma.md).

# --- Microsoft 365 / Agent 365 — RESEARCH ---
# Blocked on Frontier program enrollment + full M365 Copilot licensing.
# See docs/connectors/microsoft-365.md.
